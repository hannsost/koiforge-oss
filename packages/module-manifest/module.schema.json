{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.koiforge.dev/module.schema.json",
  "title": "KOIForge Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "trust-level",
    "requires",
    "contributes",
    "migrations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "trust-level": {
      "type": "string",
      "enum": [
        "native",
        "sandboxed",
        "declarative"
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core"
      ],
      "properties": {
        "core": {
          "type": "string"
        },
        "ontology-contracts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "default": []
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectContribution"
          },
          "default": []
        },
        "extends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extensionContribution"
          },
          "default": []
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionContribution"
          },
          "default": []
        },
        "ui": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uiContribution"
          },
          "default": []
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policyContribution"
          },
          "default": []
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      },
      "minItems": 1
    },
    "compatibility-tests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "propertyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{1,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "date",
            "datetime",
            "object",
            "array"
          ]
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "computed": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "objectContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contract-version",
        "namespace"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "contract-version": {
          "type": "integer",
          "minimum": 1
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyDefinition"
          },
          "default": []
        }
      }
    },
    "extensionContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object"
      ],
      "properties": {
        "object": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propertyDefinition"
          },
          "default": []
        }
      }
    },
    "actionContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contract-version",
        "input",
        "permissions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "contract-version": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "type": "string"
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "side-effects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "compensation": {
          "type": "string"
        }
      }
    },
    "uiContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "component"
      ],
      "properties": {
        "slot": {
          "type": "string"
        },
        "component": {
          "type": "string"
        },
        "lazy": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "policyContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "row-level",
            "column-level",
            "object-level",
            "action-level"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "strategy"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "strategy": {
          "type": "string",
          "enum": [
            "additive",
            "breaking",
            "rollback"
          ]
        }
      }
    }
  }
}

